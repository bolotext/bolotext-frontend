# Dev proxy target for /api/* (the API gateway). Used by vite.config.ts only.
API_GATEWAY_URL=http://localhost:8000
# Optional absolute API origin for production builds served without a proxy.
# Leave empty to use same-origin /api/v1.
VITE_API_BASE_URL=
# Google OAuth 2.0 Web client id for Sign in with Google (must match backend GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=857323365742-tmd4esvqfjemm4h3bh73cpttsnbmmrl0.apps.googleusercontent.com
